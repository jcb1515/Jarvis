# Optional cloud-quality voice output. Local Whisper does not use this key.
ELEVENLABS_API_KEY=

# Optional override from ElevenLabs My Voices.
# When blank, JARVIS ranks account voices for a calm British assistant profile.
ELEVENLABS_VOICE_ID=

# NVIDIA NIM agent brain using the hosted Gemma 4 endpoint.
NVIDIA_API_KEY=

# Optional local API authentication.
OPENJARVIS_API_KEY=

# Obsidian Local REST API values, if the Obsidian MCP server is enabled.
OBSIDIAN_API_KEY=
OBSIDIAN_HOST=127.0.0.1
OBSIDIAN_PORT=27124
